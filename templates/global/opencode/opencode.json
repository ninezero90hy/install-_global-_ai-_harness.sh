{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "developer",
  "instructions": ["CLAUDE.md", "src/AGENTS.md"],
  "agent": {
    "developer": {
      "permission": {
        "task": {
          "*": "deny",
          "planner": "allow",
