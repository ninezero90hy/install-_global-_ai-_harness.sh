          "reviewer": "allow",
          "tester": "allow"
        }
      }
    },
    "delivery-lead": {
      "permission": {
        "task": {
          "*": "deny",
          "planner": "allow",
          "frontend-developer": "allow",
          "backend-developer": "allow",
          "devils-advocate": "allow",
          "reviewer": "allow",
          "tester": "allow"
        }
      }
    }
  }
}
